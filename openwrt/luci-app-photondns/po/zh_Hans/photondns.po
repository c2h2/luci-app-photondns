# IPv6 (AAAA) handling settings
msgid "IPv6 (AAAA) handling"
msgstr "IPv6（AAAA）处理"

msgid "Whether to answer IPv6 (AAAA) lookups. \"Block if IPv4 exists\" suppresses IPv6 only for names that also have an IPv4 address, so IPv6-only sites still work; \"Block all\" forces every client onto IPv4."
msgstr "是否应答 IPv6（AAAA）查询。“存在 IPv4 时拦截”仅对同时拥有 IPv4 地址的域名抑制 IPv6，因此纯 IPv6 站点仍可正常访问；“全部拦截”会强制所有客户端使用 IPv4。"

msgid "Allow (default)"
msgstr "允许（默认）"

msgid "Block if IPv4 exists"
msgstr "存在 IPv4 时拦截"

msgid "Block all IPv6"
msgstr "拦截全部 IPv6"

msgid "Block special-use TLDs"
msgstr "拦截特殊用途顶级域"

msgid "Answer NXDOMAIN for special-use TLDs (.local, .lan, .internal, ...) so mDNS noise never reaches public resolvers"
msgstr "对特殊用途顶级域（.local、.lan、.internal 等）返回 NXDOMAIN，避免 mDNS 噪音到达公共解析器"

msgid "Block private PTR lookups"
msgstr "拦截私有地址 PTR 查询"

msgid "Answer NXDOMAIN for reverse (PTR) lookups of private / link-local address space instead of leaking them upstream"
msgstr "对私有/链路本地地址段的反向（PTR）查询返回 NXDOMAIN，而不是泄漏给上游"

# Prewarm settings
msgid "Prewarm popular domains"
msgstr "预热热门域名"

msgid "Keep a list of domains (default: YouTube/Google) always resolved so a first visit is never a slow cold miss. Edit the list under Rules."
msgstr "保持一组域名（默认：YouTube/Google）始终处于已解析状态，使首次访问不会因冷未命中而变慢。可在“规则”页中编辑该列表。"

msgid "Prewarm interval (s)"
msgstr "预热间隔（秒）"

msgid "How often to refresh the prewarm domains; keep it below the cache stale lifetime so they never fully expire. 0 = only at startup."
msgstr "多久刷新一次预热域名；应保持小于缓存的过期条目保留时间，使其始终不会完全过期。0 = 仅在启动时预热。"

# Log settings
msgid "Verbosity of the daemon log."
msgstr "守护进程日志的详细程度。"

msgid "Daemon log path. Leave empty to log to the system log (logread) only - no file. Note: /var on OpenWrt is RAM (tmpfs), so a file here lives in memory and is cleared on reboot."
msgstr "守护进程日志路径。留空则仅记录到系统日志（logread），不写文件。注意：OpenWrt 的 /var 是内存盘（tmpfs），此处的文件保存在内存中，重启后清空。"

# Menu / page titles
msgid "Cache Lookup"
msgstr "缓存查找"

msgid "Help"
msgstr "帮助"

# Cache Lookup page (checker.js)
msgid "Type a domain to search what photondns currently has cached. The 15 closest cached records appear as you type (↓/↑ to move, Enter to pick); selecting one runs a full resolve (cache-first) and shows the answers, route, TTL and timing. Pressing Enter without a selection resolves exactly what you typed."
msgstr "输入域名即可搜索 photondns 当前已缓存的内容。输入时会实时显示最接近的 15 条缓存记录（↓/↑ 移动，回车选择）；选中某条会执行一次完整解析（优先查缓存），并显示应答、路由、TTL 与耗时。未选中直接回车则精确解析你所输入的内容。"

msgid "Start typing a domain (e.g. github.com)..."
msgstr "开始输入域名（如 github.com）..."

msgid "%d entries cached"
msgstr "已缓存 %d 条记录"

msgid "Resolving %s..."
msgstr "正在解析 %s..."

msgid "No response from photondns (is it running?)."
msgstr "photondns 无响应（是否正在运行？）。"

msgid "Name"
msgstr "域名"

msgid "Response code"
msgstr "响应码"

msgid "Answers"
msgstr "应答"

msgid "(no address records)"
msgstr "（无地址记录）"

msgid "TTL"
msgstr "TTL"

msgid "Elapsed"
msgstr "耗时"

msgid "fresh"
msgstr "新鲜"

msgid "stale"
msgstr "过期"

# Cache Lookup page — compat-flavor variants (checker.htm)
msgid "Type a domain to search what photondns currently has cached. The 15 closest cached records appear as you type; selecting one runs a full resolve and shows the answers, route, TTL and timing."
msgstr "输入域名即可搜索 photondns 当前已缓存的内容。输入时会实时显示最接近的 15 条缓存记录；选中某条会执行一次完整解析，并显示应答、路由、TTL 与耗时。"

