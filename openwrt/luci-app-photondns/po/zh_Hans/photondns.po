msgid "Proto"
msgstr "协议"

msgid "ms"
msgstr "毫秒"

# TTL multiplier (basic.js)
msgid "TTL multiplier"
msgstr "TTL 倍率"

msgid "Scale upstream TTLs by this factor before the min/max clamp (e.g. 5 turns TTL 90 into 450); 1 = no change"
msgstr "在最小/最大 TTL 限制之前，按此倍率缩放上游 TTL（例如 5 会把 TTL 90 变为 450）；1 = 不修改"

# LAN hostnames (basic.js + rules.js)
msgid "Resolve LAN hostnames"
msgstr "解析局域网主机名"

msgid "Answer DNS for local network devices by name (learned from DHCP leases) plus a manual pin list, without depending on dnsmasq. Names resolve both bare and under the LAN suffix, and reverse (PTR) lookups work too. Edit the pin list under Rules."
msgstr "无需依赖 dnsmasq，即可按名称为局域网设备应答 DNS（从 DHCP 租约中学习），并支持手动固定列表。主机名可直接解析，也可加上局域网后缀解析，反向（PTR）查询同样有效。可在“规则”页中编辑固定列表。"

msgid "LAN domain suffix"
msgstr "局域网域名后缀"

msgid "Domain LAN names also answer under, e.g. \"lan\" makes a host \"nas\" resolve as both nas and nas.lan."
msgstr "局域网名称附加应答的域名后缀，例如设为 \"lan\" 时，主机 \"nas\" 可同时解析为 nas 和 nas.lan。"

msgid "DHCP lease file"
msgstr "DHCP 租约文件"

msgid "dnsmasq lease file to learn hostname → IP mappings from; re-read periodically."
msgstr "用于学习主机名 → IP 映射的 dnsmasq 租约文件；将定期重新读取。"

msgid "LAN refresh interval (s)"
msgstr "局域网刷新间隔（秒）"

msgid "How often to re-read the lease file so new devices appear; 0 = only at startup."
msgstr "多久重新读取一次租约文件以便发现新设备；0 = 仅在启动时读取。"

msgid "LAN record TTL (s)"
msgstr "局域网记录 TTL（秒）"

msgid "Answer TTL for LAN forward/reverse records."
msgstr "局域网正向/反向记录的应答 TTL。"

msgid "Hosts file TTL (s)"
msgstr "Hosts 文件 TTL（秒）"

msgid "Answer TTL for entries from the hosts rule file (Rules page)"
msgstr "Hosts 规则文件（规则页面）中条目的应答 TTL"

msgid "LAN Hosts"
msgstr "局域网主机"

msgid "Extra LAN hosts pinned by name → IP, one \"name ip [ip...]\" per line, for devices that do not advertise a usable DHCP name (e.g. a Mac). Each resolves bare and under the LAN suffix, and answers reverse PTR. DHCP leases are learned automatically; this file is only for pins. Enable \"Resolve LAN hostnames\" in Basic Settings."
msgstr "按名称 → IP 手动固定的额外局域网主机，每行一条 \"名称 IP [IP...]\"，适用于不广播可用 DHCP 名称的设备（如 Mac）。每条均可直接解析，也可加局域网后缀解析，并应答反向 PTR。DHCP 租约会自动学习，此文件仅用于固定项。请在基本设置中启用“解析局域网主机名”。"

# Prewarm (rules.js)
msgid "Prewarm"
msgstr "预热"

msgid "Domains kept always-resolved (one per line) so a first visit is never a slow cold miss. Default set = YouTube/Google. Enable \"Prewarm popular domains\" in Basic Settings."
msgstr "保持始终已解析的域名（每行一个），使首次访问不会因冷未命中而变慢。默认集合 = YouTube/Google。请在基本设置中启用“预热热门域名”。"

msgid "Free and open-source software, licensed under GPL-3.0-only."
msgstr "自由开源软件，采用 GPL-3.0-only 许可证。"

msgid "Bypass proxy for China DNS"
msgstr "国内 DNS 绕过代理"

msgid "Mark these queries with the bypass fwmark so a transparent proxy on this router (e.g. Passwall) sends them out directly"
msgstr "为这些查询打上绕过标记（fwmark），让本路由器上的透明代理（如 Passwall）直接放行、直连发出"

msgid "Bypass proxy for overseas DNS"
msgstr "国外 DNS 绕过代理"

msgid "Mark these queries with the bypass fwmark so they go out directly instead of through a transparent proxy on this router. On by default so DNS (incl. bootstrap) works before the proxy is up; turn off to send them through your proxy rules"
msgstr "为这些查询打上绕过标记（fwmark），直连发出而不经过本路由器上的透明代理。默认开启，使 DNS（含引导解析）在代理启动前即可工作；关闭则按代理规则走"

msgid "Bypass fwmark"
msgstr "绕过标记（fwmark）"

msgid "SO_MARK value set on upstream sockets of bypassing groups. Passwall / Passwall2 skip mark 255 (0xff)"
msgstr "绕过代理的分组在上游套接字上设置的 SO_MARK 值。Passwall / Passwall2 会放行标记 255（0xff）"

